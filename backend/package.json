{
  "name": "rag-chatbot-backend",
  "version": "2.0.0",
  "description": "RAG (Retrieval-Augmented Generation) Chatbot Backend — Train with PDFs, URLs, Q&A and chat with your data",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "chroma:start": "docker-compose up -d",
    "chroma:stop": "docker-compose down",
    "setup": "docker-compose up -d && npm install"
  },
  "keywords": ["rag", "chatbot", "ai", "embeddings", "openai", "chromadb"],
  "author": "Sahil Hirpara",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.0.0",
    "chromadb": "^1.9.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-fileupload": "^1.5.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "mongoose": "^8.7.2",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
