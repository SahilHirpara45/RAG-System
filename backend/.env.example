# ============================================
# RAG Chatbot Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
DB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# JWT Authentication
JWT_SECRET=your-secure-random-secret-key-here
JWT_EXPIRES_IN=7d

# --- ACTIVE PROVIDER: Google Gemini API (100% Free - Get key at https://aistudio.google.com/) ---
GEMINI_API_KEY=your-free-gemini-api-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072

# --- FUTURE USE: Paid OpenAI GPT Configuration (Uncomment & add key to use official OpenAI) ---
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_BASE_URL=
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-ada-002
# EMBEDDING_DIMENSION=1536

# ChromaDB (Vector Database)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=rag_chatbot

# Password Hashing
SALT_ROUNDS=10
